    1                     
    2                     ;***********************************************************************
    3                     ;       データ転送関連システム
    4                     ;***********************************************************************
    5                     
    6                     ;=======================
    7                     ; ROMの指定バンクのデータをRAMにコピーする
    8                     ;  IN: SRC_ADR 転送元アドレス 16bit
    9                     ;  IN: DST_ADR 転送先アドレス 16bit
   10                     ;  IN: Y 転送サイズ
   11                     ;  破壊 A,Y
   12                     ;=======================
   13  03:EB50            memcpy:
   14  03:EB50            .loop
   15  03:EB50  88                dey
   16  03:EB51  B1 56             lda  [SRC_ADR],y
   17  03:EB53  91 58             sta  [DST_ADR],y
   18  03:EB55  C0 00             cpy  #0
   19  03:EB57  D0 F7             bne  .loop
   20  03:EB59  60                rts
   21                     
   22                     
   23                     
   24                     ;=======================
   25                     ; 背景データ 2C00       *
   26                     ;=======================
   27  03:EB5A            CLEAR_BG_2C:
   28  03:EB5A  48                PHA
   29                             SET_VRAM_ADD2 #$2C00
       03:EB5B  A9 2C             lda #HIGH (#$2C00)
       03:EB5D  8D 06 20      sta $2006
       03:EB60  A9 00             lda #LOW  (#$2C00)
       03:EB62  8D 06 20          sta $2006
   30  03:EB65  68                PLA
   31  03:EB66  4C 77 EB          jmp CLEAR_BG_00
   32  03:EB69            BAK_CLR_RTN:
   33  03:EB69  A9 00             LDA     #$00
   34  03:EB6B            CLEAR_BG:
   35  03:EB6B  48                PHA
   36                             SET_VRAM_ADD2 #$2000
       03:EB6C  A9 20             lda #HIGH (#$2000)
       03:EB6E  8D 06 20      sta $2006
       03:EB71  A9 00             lda #LOW  (#$2000)
       03:EB73  8D 06 20          sta $2006
   37  03:EB76  68                PLA
   38                     
   39  03:EB77            CLEAR_BG_00:
   40                     
   41  03:EB77  A2 03             ldx     #3
   42  03:EB79            CLEAR_BG_DATA_L1:
   43  03:EB79  A0 00             ldy     #0
   44  03:EB7B            CLEAR_BG_DATA_L0:
   45  03:EB7B  8D 07 20          sta     $2007
   46  03:EB7E  88                dey
   47  03:EB7F  D0 FA             bne     CLEAR_BG_DATA_L0
   48  03:EB81  CA                dex
   49  03:EB82  D0 F5             bne     CLEAR_BG_DATA_L1
   50                     
   51  03:EB84  A0 C0             LDY     #$C0
   52                     ;       JSR  CLEAR_VRAM
   53  03:EB86            CLEAR_BG_DATA_L2:
   54  03:EB86  8D 07 20          sta     $2007
   55  03:EB89  88                dey
   56  03:EB8A  D0 FA             bne     CLEAR_BG_DATA_L2
   57                     
   58                     
   59  03:EB8C  A9 00             LDA     #$00
   60  03:EB8E  A0 40             LDY     #$40
   61                     ;       JSR  CLEAR_VRAM
   62  03:EB90            CLEAR_BG_DATA_L3:
   63  03:EB90  8D 07 20          sta     $2007
   64  03:EB93  88                dey
   65  03:EB94  D0 FA             bne     CLEAR_BG_DATA_L3
