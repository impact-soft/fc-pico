  306  03:EDA8  0A                asl  a
  307  03:EDA9  0A                asl  a
  308  03:EDAA  0A                asl  a
  309  03:EDAB  0A                asl  a
  310  03:EDAC  05 4A             ora  <TMP_SV2
  311  03:EDAE  9D 00 01          sta  $100,x
  312  03:EDB1  60                rts
