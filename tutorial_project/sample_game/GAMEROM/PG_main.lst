  244                     ;                               VRAMアドレスセット
  245                     ;                               VRAMアドレス = \1(16bit adr)
  246                     ;------------------------------------------------------------------------------
  247                     SET_VRAM_ADD2   MACRO
  248                             lda #HIGH (\1)
  249                         sta $2006
  250                             lda #LOW  (\1)
  251                             sta $2006
  252                             ENDM
  253                     
  254                     ;------------------------------------------------------------------------------
  255                     ;                               VRAMアドレスセット
  256                     ;                               VRAMアドレス = \1(16bit adr)
  257                     ;------------------------------------------------------------------------------
  258                     SET_VRAM_ADD_A_00       MACRO
  259                             STA  $2006
  260                             LDA     #$00
  261                             STA  $2006
  262                             ENDM
