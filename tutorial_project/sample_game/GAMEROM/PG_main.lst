  178                     ;------------------------------------------------------------------------------
  179                     ;                               XYレジスタをスタックに退避
  180                     ;------------------------------------------------------------------------------
  181                     phxy            MACRO
  182                             sta  <TMP_SYS
  183                             txa
  184                             pha
  185                             tya
  186                             pha
  187                             lda  <TMP_SYS
  188                             ENDM
  189                     
  190                     ;------------------------------------------------------------------------------
  191                     ;                               XYレジスタをスタックから復帰
  192                     ;------------------------------------------------------------------------------
  193                     plxy            MACRO
  194                             sta  <TMP_SYS
  195                             pla
  196                             tay
  197                             pla
  198                             tax
  199                             lda  <TMP_SYS
  200                             ENDM
  201                     
  202                     ;------------------------------------------------------------------------------
  203                     ;                               SRC_ADRをスタックに退避
  204                     ;------------------------------------------------------------------------------
  205                     phSRC_ADR       MACRO
  206                             lda  <SRC_ADR+0
  207                             pha
  208                             lda  <SRC_ADR+1
  209                             pha
  210                             ENDM
  211                     
  212                     ;------------------------------------------------------------------------------
  213                     ;                               XYレジスタをスタックから復帰
  214                     ;------------------------------------------------------------------------------
  215                     plSRC_ADR       MACRO
  216                             pla
  217                             sta  <SRC_ADR+1
  218                             pla
  219                             sta  <SRC_ADR+0
  220                             ENDM
