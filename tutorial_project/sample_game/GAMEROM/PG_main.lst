  359                     ;------------------------------------------------------------------------------
  360                     ;                               文字列描画
  361                     ;                               \1 = 文字列
  362                     ;------------------------------------------------------------------------------
  363                     DRAW_STRING2 MACRO
  364                             LDA  #HIGH (.end\@ -1)
  365                             PHA
  366                             LDA  #LOW (.end\@ -1)
  367                             PHA
  368                             LDA  #LOW (.tbl\@ )
  369                             STA  <SRC_ADR
  370                             LDA  #HIGH (.tbl\@ )
  371                             jmp  DRAW_STRING_SUB
  372                     .tbl\@:
  373                         db  \1,0
  374                     .end\@:
  375                             ENDM
  376                     
  377                     ;------------------------------------------------------------------------------
  378                     ;                               文字列描画
  379                     ;                               データソースアドレス = \1 (16bit adr)
  380                     ;------------------------------------------------------------------------------
  381                     DRAW_STRING     MACRO
  382                             lda     #\1 & $ff
  383                             STA     <SRC_ADR
  384                             LDA     #\1 >> 8
  385                     ;;      STA     <SRC_ADR+1
  386                             JSR     DRAW_STRING_SUB
  387                             ENDM
  388                     
  389                     ;------------------------------------------------------------------------------
  390                     ;                               文字列描画（クリアー切り替え付き）
  391                     ;                               データソースアドレス = \1 (16bit adr)
  392                     ;------------------------------------------------------------------------------
  393                     DRAW_STRING_S   MACRO
  394                             lda     #\1 & $ff
  395                             STA     <SRC_ADR
  396                             LDA     #\1 >> 8
  397                     ;;      STA     <SRC_ADR+1
  398                             JSR     DRAW_STRING_S_SUB
  399                             ENDM
  400                     
  401                     ;------------------------------------------------------------------------------
  402                     ;                               文字列描画（テーブル選択型）
  403                     ;                               A reg = テーブル選択番号
  404                     ;                               テーブルデータアドレス = \1 (16bit adr)
  405                     ;------------------------------------------------------------------------------
  406                     DRAW_STRING_TBL_SEL     MACRO
  407                             ASL     A
  408                             TAX
  409                             LDA     \1,X
  410                             STA     <SRC_ADR
  411                             LDA     \1+1,X
  412                     ;;      STA     <SRC_ADR+1
  413                             JSR     DRAW_STRING_SUB
  414                             ENDM
