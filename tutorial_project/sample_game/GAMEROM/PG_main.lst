  472                     ;                               RAM転送システム用のマクロ
  473                     ;=================================================================
  474                     
  475                     ;------------------------------------------------------
  476                     ; VRAM転送先アドレス指定マクロ
  477                     ;------------------------------------------------------
  478                     SET_VRAMT_ADR   MACRO
  479                             lda   #HIGH (\1)
  480                             jsr   writeVRAMT_DATA
  481                             lda   #LOW  (\1)
  482                             jsr   writeVRAMT_DATA
  483                             ENDM
