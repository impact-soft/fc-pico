  100  03:EBA6  A5 59             lda  <DST_ADR+1
  101  03:EBA8  8D 06 20      sta  $2006
  102  03:EBAB  A9 FF             lda  #$FF
  103  03:EBAD  85 59             sta  <DST_ADR+1
  104  03:EBAF  A5 58             lda <DST_ADR+0
  105  03:EBB1  8D 06 20          sta $2006
  106                     
