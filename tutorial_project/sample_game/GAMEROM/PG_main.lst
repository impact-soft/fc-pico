  251                     ;=======================
  252                     ; 2進化10進 8ビット加算
  253                     ;   A reg 加算する値（BCD値）
  254                     ;   X reg $1xx のワークの下位アドレス8bit
  255                     ;=======================
  256                     
  257  03:ED66            BCD_ADD:
  258                             ; 加算する値を上下4ビットずつに分離
  259  03:ED66  A8                tay
  260  03:ED67  29 0F             and  #$0F
  261  03:ED69  85 48             sta  <TMP_SV0
  262  03:ED6B  98                tya
  263  03:ED6C  29 F0             and  #$F0
  264  03:ED6E  4A                lsr  a
  265  03:ED6F  4A                lsr  a
  266  03:ED70  4A                lsr  a
  267  03:ED71  4A                lsr  a
  268  03:ED72  85 49             sta  <TMP_SV1
  269                             
  270  03:ED74  BD 00 01          lda  $100,x
  271  03:ED77  A8                tay
  272  03:ED78  29 0F             and  #$0F
  273  03:ED7A  85 4A             sta  <TMP_SV2
  274  03:ED7C  98                tya
  275  03:ED7D  29 F0             and  #$F0
  276  03:ED7F  4A                lsr  a
  277  03:ED80  4A                lsr  a
  278  03:ED81  4A                lsr  a
  279  03:ED82  4A                lsr  a
  280  03:ED83  85 4B             sta  <TMP_SV3
  281                     
  282                             ; 下位4ビットを加算
  283  03:ED85  A5 48             lda  <TMP_SV0
  284  03:ED87  18                clc
  285  03:ED88  65 4A             adc  <TMP_SV2
  286  03:ED8A  C9 0A             cmp  #10
  287  03:ED8C  90 04             bcc  BCD_00
  288  03:ED8E  E9 0A             sbc  #10
  289  03:ED90  E6 49             inc  <TMP_SV1
  290  03:ED92            BCD_00:
  291  03:ED92  85 4A             sta  <TMP_SV2
  292                     
  293                             ; 上位4ビットを加算
  294  03:ED94  A5 49             lda  <TMP_SV1
  295  03:ED96  18                clc
  296  03:ED97  65 4B             adc  <TMP_SV3
  297  03:ED99  C9 0A             cmp  #10
  298  03:ED9B  90 0B             bcc  BCD_01
  299  03:ED9D  E9 0A             sbc  #10
  300  03:ED9F  20 A8 ED          jsr  BCD_01
  301  03:EDA2  E8                inx
  302  03:EDA3  A9 01             lda  #1
  303  03:EDA5  4C 66 ED          jmp  BCD_ADD
