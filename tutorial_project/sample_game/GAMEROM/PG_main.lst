   82                     ;       BPE デコード
   83                     ;
   84                     ;  SRC_ADR =  データ格納アドレス
   85                     ;  DST_ADR =  展開先VRAMアドレス
   86                     ;------------------------------------------------
   87           004F      BPE_pass                EQU  TMP_SV7
   88           0050      BPE_decompsize  EQU  TMP_WRK0           ; 展開サイズ
   89           0052      BPE_compsize    EQU  TMP_WRK2           ; 圧縮サイズ
   90                     
   91           0048      BPE_DIC_H               EQU  TMP_SV0
   92           004A      BPE_DIC_L               EQU  TMP_SV2
   93           004C      BPE_DIC_O               EQU  TMP_SV4
   94           0700      BPE_DT_BUF              EQU  BPE_BUF
   95           0780      BPE_IX_BUF              EQU  BPE_BUF+$80
   96                     
   97                     
   98  03:EBA6            bpe_dec_vram:
