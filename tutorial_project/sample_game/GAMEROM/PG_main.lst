  105                     ;------------------------------------------------------------------------------
  106                     ;               擬似ワードレジスタ　AR に固定ワードセット
  107                     ;------------------------------------------------------------------------------
  108                     SET_AR  MACRO
  109                             LDA     \1 & $ff
  110                             STA     <W_AR
  111                             LDA     \1 >> 8
  112                             STA     <W_AR+1
  113                             ENDM
  114                     
  115                     ;------------------------------------------------------------------------------
  116                     ;               擬似ワードレジスタ　BR に固定ワードセット
  117                     ;------------------------------------------------------------------------------
  118                     SET_BR  MACRO
  119                             LDA     \1 & $ff
  120                             STA     <W_BR
  121                             LDA     \1 >> 8
  122                             STA     <W_BR+1
  123                             ENDM
  124                     
  125                     ;------------------------------------------------------------------------------
  126                     ;               擬似ワードレジスタ　AR にメモリー上のワード値セット
  127                     ;------------------------------------------------------------------------------
  128                     SET_AR_M        MACRO
  129                             LDA     \1
  130                             STA     <W_AR
  131                             LDA     \1+1
  132                             STA     <W_AR+1
  133                             ENDM
  134                     
  135                     ;------------------------------------------------------------------------------
  136                     ;               擬似ワードレジスタ　BR にメモリー上のワード値セット
  137                     ;------------------------------------------------------------------------------
  138                     SET_BR_M        MACRO
  139                             LDA     \1
  140                             STA     <W_BR
  141                             LDA     \1+1
  142                             STA     <W_BR+1
  143                             ENDM
  144                     
  145                     ;------------------------------------------------------------------------------
  146                     ;                               対象のメモリーのビットをセットする
  147                     ;                               対象メモリーアドレス = \1
  148                     ;                               セットするビット     = \2
  149                     ;------------------------------------------------------------------------------
  150                     SET_BIT         MACRO
  151                             LDA     \1
  152                             ORA     \2
  153                             STA     \1
  154                             ENDM
  155                     
  156                     ;------------------------------------------------------------------------------
  157                     ;                               対象のメモリーのビットをクリアーする
  158                     ;                               対象メモリーアドレス = \1
  159                     ;                               クリアーするビット   = \2
  160                     ;------------------------------------------------------------------------------
  161                     CLR_BIT         MACRO
  162                             LDA     \1
  163                             AND     $ff - \2
  164                             STA     \1
  165                             ENDM
  166                     
  167                     ;------------------------------------------------------------------------------
  168                     ;                               対象のメモリーのビットをチェックする
  169                     ;                               対象メモリーアドレス = \1
  170                     ;                               チェックするビット   = \2
  171                     ;------------------------------------------------------------------------------
  172                     CHK_BIT         MACRO
  173                             LDA     \1
  174                             AND     \2
  175                             ENDM
