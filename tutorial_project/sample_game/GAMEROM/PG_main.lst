  421                     ;******************************************************************************
  422                     ;       テーブル関係
  423                     ;******************************************************************************
  424                     
  425                     ;------------------------------------------------------------------------------
  426                     ;                               テーブルジャンプ
  427                     ;                               A reg = ジャンプ先テーブル番号
  428                     ;------------------------------------------------------------------------------
  429                     TBL_JUMP        MACRO
  430                             ASL     A
  431                             stx  <TMP_SYS
  432                             TAX
  433                             LDA     .tbl\@+1,X
  434                             PHA
  435                             LDA     .tbl\@+0,X
  436                             ldx  <TMP_SYS
  437                             PHA
  438                             RTS
  439                     .tbl\@:
  440                             ENDM
  441                     
  442                     ;------------------------------------------------------------------------------
  443                     ;  テーブルジャンプ先　宣言用マクロ　スタックを使う場合ジャンプ先-1 をプッシュ
  444                     ;------------------------------------------------------------------------------
  445                     JPTBL   MACRO
  446                             DW      \1 -1
  447                             ENDM
