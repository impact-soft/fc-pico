  265                     ;------------------------------------------------------------------------------
  266                     ;                               データアドレスセット
  267                     ;                               データアドレス = \1 (16bit adr)
  268                     ;------------------------------------------------------------------------------
  269                     SET_DATA_SRC    MACRO
  270                             lda     #LOW (\1)
  271                             sta     <SRC_ADR
  272                             lda #HIGH (\1)
  273                         sta <SRC_ADR+1
  274                             ENDM
  275                     
  276                     ;------------------------------------------------------------------------------
  277                     ;                               データアドレスセット
  278                     ;                               データアドレス = \1 (16bit adr)
  279                     ;------------------------------------------------------------------------------
  280                     SET_DATA_DST    MACRO
  281                             lda     #LOW (\1)
  282                             sta     <DST_ADR
  283                             lda #HIGH (\1)
  284                         sta <DST_ADR +1
  285                             ENDM
  286                     
  287                     
  288                     ;------------------------------------------------------------------------------
  289                     ;                               データアドレスセット
  290                     ;                               データアドレス = \1 (16bit adr)
  291                     ;                               データアドレス = \2 (16bit adr)
  292                     ;------------------------------------------------------------------------------
  293                     SET_DATA_ADR    MACRO
  294                             lda     #LOW (\2)
  295                             sta     \1
  296                             lda #HIGH (\2)
  297                         sta \1+1
  298                             ENDM
