    1                     ;========================================
    2                     
    3                     
    4                     ;----------------
    5                     ; サウンドドライバーのワーク
    6                     ;----------------
    7           0000      SND_WK0         EQU     $00     ; size $32
    8                     
    9                     ;========================================
   10                     ;  NSF再生用
   11                     ;========================================
   12           0005      __ptr           EQU     $05     ; 汎用ポインタ 2byte
   13           0007      __tmp           EQU     $07
   14                     
   15           000A      __flag          EQU $0A
   16           0000       .if 0
   26                      .endif
   27                     
   28                     ;========================================
   29           0040      W_AR            EQU     $40     ; 16 bit 計算用  2 bytes
   30           0042      W_BR            EQU     $42     ; 16 bit 計算用  2 bytes
   31                     
