    1                     ;******************************************************************************
    2                     ;       MOVE関係
    3                     ;******************************************************************************
    4                     LD_W MACRO
    5                             lda  \2
    6                             sta  \1
    7                             lda  \2+1
    8                             sta  \1+1
    9                             ENDM
   10                     
   11                     ;******************************************************************************
   12                     ;       算術関係
   13                     ;******************************************************************************
   14                     
   15                     ADD_W MACRO
   16                             clc
   17                             lda  \1
   18                             adc  \2
   19                             sta  \1
   20                             lda  \1+1
   21                             adc  \2+1
   22                             sta  \1+1
   23                             ENDM
   24                     
   25                     ;------------------------------------------------------------------------------
   26                     ;                               バイト足し演算
   27                     ;------------------------------------------------------------------------------
   28                     add     MACRO
   29                             clc
   30                             adc     \1
   31                             ENDM
   32                     ;------------------------------------------------------------------------------
   33                     ;                               バイト引き演算
   34                     ;------------------------------------------------------------------------------
   35                     sub     MACRO
   36                             sec
   37                             sbc     \1
   38                             ENDM
   39                     ;------------------------------------------------------------------------------
   40                     ;                               ワード足し演算
   41                     ;                               xy + \1\2 = xy
   42                     ;------------------------------------------------------------------------------
   43                     addw    MACRO
   44                             pha
   45                     
   46                             tya
   47                             add     \2
   48                             tay
   49                             bne     .byte_over\@
   50                             bcc     .byte_over\@
   51                     
   52                             sec
   53                     .byte_over\@:
   54                             txa
   55                             adc     \1
   56                             tax
   57                     
   58                             pla
   59                             ENDM
   60                     ;------------------------------------------------------------------------------
   61                     ;                               ワード引き演算
   62                     ;                               xy - \1\2 = xy
   63                     ;------------------------------------------------------------------------------
   64                     subw    MACRO
   65                             pha
   66                     
   67                             tya
   68                             sub     \2
   69                             tay
   70                     
   71                             txa
   72                             sbc     \1
   73                             tax
   74                     
   75                             pla
   76                             ENDM
   77                     
   78                     ;------------------------------------------------------------------------------
   79                     ;                               ワードインクリメント
   80                     ;                               \1\2 + 1 = \1\2
   81                     ;------------------------------------------------------------------------------
   82                     incw    MACRO
   83                             inc     \1
   84                             bne     .iend\@
   85                     
   86                             inc     \1 + 1
   87                     .iend\@:
   88                     
   89                             ENDM
   90                     
   91                     ;------------------------------------------------------------------------------
   92                     ;                               ワードデクリメント
   93                     ;                               \1\2 - 1 = \1\2
   94                     ;------------------------------------------------------------------------------
   95                     decw    MACRO
   96                             lda     \1
   97                             bne     .dend\@
   98                     
   99                             dec     \1 + 1
  100                     .dend\@:
  101                             dec     \1
  102                     
  103                             ENDM
