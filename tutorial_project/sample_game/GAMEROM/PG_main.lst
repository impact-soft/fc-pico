  312                     ;------------------------------------------------------------------------------
  313                     ;                               ネームテーブル＆パレット転送
  314                     ;                               データアドレス = \1 (バンク付アドレス)
  315                     ;------------------------------------------------------------------------------
  316                     DRAW_BG_DATA    MACRO
  317                             lda  #LOW (\1)
  318                             sta  <SRC_ADR
  319                             lda  #HIGH (\1)
  320                         sta  <SRC_ADR+1
  321                             ldx  #BANK (\1) /2
  322                             jsr  TRANS_NAME_PAL
  323                             ENDM
  324                     
  325                     ;------------------------------------------------------------------------------
  326                     ;                               ネームテーブル転送
  327                     ;                               データアドレス = \1 (バンク付アドレス)
  328                     ;------------------------------------------------------------------------------
  329                     DRAW_BG_DATA_NP MACRO
  330                             lda  #LOW (\1)
  331                             sta  <SRC_ADR
  332                             lda  #HIGH (\1)
  333                         sta  <SRC_ADR+1
  334                             ldx  #BANK (\1) /2
  335                             lda  <A0_BNK            ;
  336                             pha                     ;現行のバンクを保存
  337                             txa
  338                             jsr  CHG_A0_BANK
  339                             jsr  TRANS_NAMETBL_SUB
  340                     
  341                             pla
  342                             jsr  CHG_A0_BANK
  343                             ENDM
  344                     
  345                     
  346                     ;------------------------------------------------------------------------------
  347                     ;                               ネームテーブル転送
  348                     ;                               データアドレス = \1 (バンク付アドレス)
  349                     ;------------------------------------------------------------------------------
  350                     DRAW_BG_TEXT    MACRO
  351                             lda  #LOW (\1)
  352                             sta  <SRC_ADR
  353                             lda  #HIGH (\1)
  354                         sta  <SRC_ADR+1
  355                             ldx  #BANK (\1) /2
  356                             jsr  TRANS_TEXT
  357                             ENDM
