  116                             ;----------------------------------------------------------------------
  117                             ; 4 回読込み版 - 1 回分サブ
  118                             ;----------------------------------------------------------------------
  119                             ; こちらの版は 2 フレーム間での比較を行わないため、
  120                             ; 反応が良くなって既存のゲームバランスに影響が出てしまった。
  121                             ; そのため、やむなく使用しないこととなった。
  122  03:EA01            .read:
  123  03:EA01  A9 01             lda     #1                      ; 2
  124  03:EA03  85 C5             sta     <KEY_NEW                ; 3
  125  03:EA05  8D 16 40          sta      $4016                  ; 4
  126  03:EA08  4A                lsr      a                      ; 2  =lda #0
  127  03:EA09  8D 16 40          sta      $4016                  ; 4
  128  03:EA0C            .read_loop:
  129  03:EA0C  AD 16 40          lda      $4016                  ; 4x
  130  03:EA0F  29 03             and     #(%11<<0)               ; 2x
  131  03:EA11  C9 01             cmp     #(%01<<0)               ; 2x
  132  03:EA13  26 C5             rol     <KEY_NEW                ; 5x
