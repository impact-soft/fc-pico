  300                     ;------------------------------------------------------------------------------
  301                     ;                               パレット転送
  302                     ;                               データアドレス = \1 (アドレス)
  303                     ;------------------------------------------------------------------------------
  304                     TRANS_PAL       MACRO
  305                             lda  #LOW (\1)
  306                             sta  <SRC_ADR
  307                             lda  #HIGH (\1)
  308                         sta  <SRC_ADR+1
  309                             jsr  SET_PAL_DATA
  310                             ENDM
