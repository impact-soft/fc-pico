   16                     
   17                     
   18           0000      AUTO_SHOT_OFF = 0                       ; =1 の時、通常弾のオートショットをＡボタン押しっぱなしで停止出来る
   19                     
   20                     
   21           0000      SINGLE_SHOT_TEST = 0            ; =1 自機の通常弾1発のみテスト
   22           0000      STAGE_TEST               = 0            ; !=0  指定ステージからスタート =8 テスト
   23                     
   24           0000      MMC_TYPE = 0                            ; =0 MMC3  =1 AX-A1 =2 INL-SWAP
   25           0001      NO_COPY_PROTECT =  1            ; =1 コピープロテクト無し
   26           00A4      FLASH_DEV_CODE = $A4
   27           00C2      FLASH_MAN_CODE = $C2
   28           0000      WRAM_PROTECT_CODE = 0
   29                     
