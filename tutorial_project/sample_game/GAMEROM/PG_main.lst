  487                     ;-------------------------------------------------------------------------------
  488                     ; メモリー制御
  489                     ;-------------------------------------------------------------------------------
  490                     
  491                     ;   A reg クリアーデータ
  492                     ;   Y reg クリアーサイズ ( 0 は 256バイト )
  493                     ;       \1 = クリアーメモリーアドレス (16bit adr)
  494                     
  495                     CLEAR_MEM       macro
  496                     
  497                     .loop\@:
  498                             dey
  499                             sta   \1,Y
  500                             bne   .loop\@
  501                     
  502                                     endm
  503                     
  504                     
  505                     COPY_TBL        macro
  506                             ldx  #0
  507                     .loop\@:
  508                             lda  \1,x
  509                             sta  \2,x
  510                             inx
  511                             cpx  #\3
  512                             bne   .loop\@
  513                                     endm
  514                     
  515                     
  516                     ;       \1 = 転送元アドレス (BNK+16bit adr)
  517                     ;       \2 = 転送先アドレス (16bit adr)
  518                     ;       \3 = 転送サイズ (8bit)
  519                     
  520                     COPY_MEM        macro
  521                             lda  #LOW (\1)
  522                             sta  <SRC_ADR
  523                             lda  #HIGH (\1)
  524                         sta  <SRC_ADR+1
  525                     
  526                             lda  #LOW (\2)
  527                             sta  <DST_ADR
  528                             lda  #HIGH (\2)
  529                         sta  <DST_ADR+1
  530                     
  531                             ldy  #HIGH (\3)
  532                             jsr  memcpy
  533                     
  534                             endm
  535                     
  536                     ;       \1 = 転送元アドレス (BNK+16bit adr)
  537                     ;       \2 = 転送先アドレス (16bit adr)
  538                     ;       \3 = 転送サイズ (16bit)
  539                     
  540                     COPY_MEM16      macro
  541                             lda  #LOW (\1)
  542                             sta  <SRC_ADR
  543                             lda  #HIGH (\1)
  544                         sta  <SRC_ADR+1
  545                     
  546                             lda  #LOW (\2)
  547                             sta  <DST_ADR
  548                             lda  #HIGH (\2)
  549                         sta  <DST_ADR+1
  550                     
  551                             ldy  #LOW (\3)
  552                             ldx  #HIGH (\3)
  553                     
  554                             lda  #BANK (\1) /2
  555                     
  556                             jsr  memcpy_x
  557                     
  558                             endm
  559                     
  560                     
  561                     
  562                     ;-------------------------------------------------------------------------------
  563                     ; BEEP
  564                     ;-------------------------------------------------------------------------------
  565                     
  566                     BEEP    MACRO
  567                             lda #0
  568                             sta $4015
  569                     
  570                     ;       lda $4015               ; サウンドレジスタ
  571                     ;       ora #%00000001  ; 矩形波チャンネル１を有効にする
  572                             lda #%00000001  ; 矩形波チャンネル１を有効にする
  573                             sta $4015
  574                     
  575                             lda #%10111111  ; Duty比・長さ無効・減衰無効・減衰率
  576                             sta $4000       ; 矩形波チャンネル１制御レジスタ１
  577                     
  578                     ;       lda #%10101011  ; スイープ有効・変化率・方向・変化量
  579                     ;       lda #%00101011  ; スイープ有効・変化率・方向・変化量
  580                             lda #(\2)       ; スイープ有効・変化率・方向・変化量
  581                             sta $4001       ; 矩形波チャンネル１制御レジスタ２
  582                             
  583                             lda #LOW(\1)    ; 周波数(下位8ビット)
  584                             sta $4002       ; 矩形波チャンネル１周波数レジスタ１
  585                             lda #%11111000 +(HIGH(\1) &7)   ; 再生時間・周波数(上位3ビット)
  586                             sta $4003       ; 矩形波チャンネル１周波数レジスタ２
  587                     
  588                             ENDM
  589                     
