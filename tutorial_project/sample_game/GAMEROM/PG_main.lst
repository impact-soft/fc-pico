   42                             .INCLUDE        ".\cfg\cfgEnemyNT.h"
    1                     ;===============================================================================================
    2                     ; 敵ノーマル弾移動データテーブル
    3                     ;
    4                     ;===============================================================================================
    5                     
    6           0001      NTK_ANGLE       EQU             1       ; 自機狙い弾
    7           0002      NTK_NOMAL       EQU             2       ; 通常弾
    8           0003      NTK_HORMI       EQU             3       ; ホーミング弾
    9           0004      NTK_MISS        EQU             4       ; ミサイル弾
   10           0006      NTK_HHORM       EQU             6       ; 半誘導弾
   11           0008      NTK_HHORM3      EQU             8       ; 半誘導弾３分裂
   12           008B      NTK_METEO       EQU             $80+11  ; 隕石
   13           008C      NTK_WARP        EQU             $80+12  ; ワープエフェクト
   14           008D      NTK_SPZK0       EQU             $80+13  ; SPザコ0
   15           008E      NTK_SPZK1       EQU             $80+14  ; SPザコ1
   16           008F      NTK_SPZK2       EQU             $80+15  ; SPザコ2
   17           0090      NTK_LIFE        EQU             $80+16  ; ライフ回復
   18                     
   19                     
   20                     ; データフォーマット
   21                     ; 0:  見た目番号ｘ４＋パレット選択
   22                     ; 1:  HP  0->当たり判定なし 255->無敵
   23                     ; 2:  拡張番号
   24                     ; 3:  拡張パラメータ:弾種切り替えタイマー
   25                     
   26                     ; 拡張番号メモ
   27                     ; 0:特殊処理なし
   28                     ; 1:自機方向に方向転換
   29                     ; 2:ホーミング
   30                     ; 3:ミサイル上昇 X軸によって方向補正　画面外消去特殊処理
   31                     ; 4:ミサイル下降 X軸によって方向補正
   32                     ; 5:進行方向に向けて３分裂
   33                     ; 6:自己消滅
   34                     ; 7:６方向炸裂
   35                     ; 8:近接信管
   36                     ;
   37                     
   38                     
   39                     
   40                     
   41                     NT_CFG MACRO
   42                             db \1 * 4 + \2  ; 見た目＋パレット
   43                             db \3                   ; HP (=0当たり判定なし）
   44                             db \4                   ; 拡張番号
   45                             db \5                   ; 拡張パラメータ
   46                     
   47                             ENDM
   48                     
   49                     
   50                     ;  最大64種類登録可能
   51  02:C000            tblEnemyNTcfg:
   52                             NT_CFG 2,2,0,1,0                ; 1 自機狙い弾 発射時
       02:C000  0A                db 2 * 4 + 2  ; 見た目＋パレット
