  450                     ;=================================================================
  451                     ;                               NMIユーザー処理登録用マクロ
  452                     ;=================================================================
  453                     SET_NMI_CALL    MACRO
  454                             LDA     #HIGH (\1)
  455                             STA <NMI_CALL_ADR+1
  456                             LDA     #LOW  (\1)
  457                             STA <NMI_CALL_ADR
  458                             LDA     #BANK (\1) /2
  459                             STA <NMI_CALL_BNK
  460                             ENDM
  461                     
  462                     
  463                     ;=================================================================
  464                     ;                               NMIユーザー処理解除用マクロ
  465                     ;=================================================================
  466                     CLR_NMI_CALL    MACRO
  467                             LDA     #0
  468                             STA <NMI_CALL_BNK
  469                             ENDM
