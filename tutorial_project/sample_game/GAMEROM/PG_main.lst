    1                     ;========================================
    2                     ; Key System
    3                     ;========================================
    4                     
    5           0000      SYSKEY_OLD  EQU  0
    6                     
    7                     
    8                     ;*****************************************
    9                     ;キーの方向を取得
   10                     ;*****************************************
   11  03:E98D            KEY_DIR:
   12  03:E98D  A5 C5             lda  <KEY_NEW
   13  03:E98F  29 0F             and  #$0F
   14  03:E991  AA                tax
   15  03:E992  BD 96 E9          lda  .tbl,x
   16  03:E995  60                rts
   17                     
   18                     
   19  03:E996            .tbl
   20  03:E996  FF                db  KDIR_N      ; 0000 入力無し
   21  03:E997  02                db  KDIR_R      ; 0001 KEY_RIGHT
   22  03:E998  06                db  KDIR_L      ; 0010 KEY_LEFT
   23  03:E999  FF                db  KDIR_N      ; 0011 KEY_RIGHT + KEY_LEFT
   24  03:E99A  04                db  KDIR_D      ; 0100 KEY_DOWN
   25  03:E99B  03                db  KDIR_DR     ; 0101 KEY_DOWN + KEY_RIGHT
   26  03:E99C  05                db  KDIR_DL     ; 0110 KEY_DOWN + KEY_LEFT
   27  03:E99D  04                db  KDIR_D      ; 0111 KEY_DOWN + KEY_RIGHT + KEY_LEFT
   28  03:E99E  00                db  KDIR_U      ; 1000 KEY_UP
   29  03:E99F  01                db  KDIR_UR     ; 1001 KEY_UP + KEY_RIGHT
   30  03:E9A0  07                db  KDIR_UL     ; 1010 KEY_UP + KEY_LEFT
   31  03:E9A1  00                db  KDIR_U      ; 1011 KEY_UP + KEY_RIGHT + KEY_LEFT
   32  03:E9A2  FF                db  KDIR_N      ; 1100 KEY_UP + KEY_DOWN
   33  03:E9A3  02                db  KDIR_R      ; 1101 KEY_UP + KEY_DOWN + KEY_RIGHT
   34  03:E9A4  06                db  KDIR_L      ; 1110 KEY_UP + KEY_DOWN + KEY_LEFT
   35  03:E9A5  FF                db  KDIR_N      ; 1111 KEY_UP + KEY_DOWN + KEY_RIGHT + KEY_LEFT
   36                     
   37                     ;****************
   38                     ; KEY RTN       *
   39                     ;****************
   40                     ;
   41  03:E9A6            KEY_RTN:
   42                             ;----------------------------------------------------------------------
   43                             ; 4 回読込み版
   44                             ;----------------------------------------------------------------------
   45  03:E9A6  A5 C5             lda     <KEY_NEW
   46  03:E9A8  85 C4             sta     <KEY_OLD
   47                     
   48  03:E9AA  20 01 EA           jsr    .read                   ; 6+153
   49  03:E9AD  85 C7              sta    <KEY_CH1                ; 3
   50  03:E9AF  20 01 EA           jsr    .read                   ; 6+153
   51  03:E9B2  48                 pha                            ; 3
   52  03:E9B3  20 01 EA            jsr   .read                   ; 6+153
   53  03:E9B6  85 C9               sta   <KEY_CH3                ; 3
   54  03:E9B8  20 01 EA            jsr   .read                   ; 6+153  (645)
   55  03:E9BB  68                 pla                            ; (2nd read)
   56  03:E9BC  C5 C7             cmp     <KEY_CH1
   57  03:E9BE  F0 06             beq     .store                  ; XX--
   58  03:E9C0  C5 C5             cmp     <KEY_NEW                ; (4th read)
   59  03:E9C2  F0 02             beq     .store                  ; -X-X
   60  03:E9C4  A5 C9             lda     <KEY_CH3                ; X-X-
   61                                                             ; -XX-
   62                                                             ; --XX
   63  03:E9C6            .store:
   64  03:E9C6  85 C5             sta     <KEY_NEW
   65                     
   66                     ;;      lda     <KEY_NEW
   67  03:E9C8  45 C4             eor     <KEY_OLD
   68  03:E9CA  48                pha
   69  03:E9CB  25 C5              and    <KEY_NEW
   70  03:E9CD  85 C3              sta    <KEY_TRG
   71  03:E9CF  68                pla
   72  03:E9D0  25 C4             and     <KEY_OLD
   73  03:E9D2  85 C2             sta     <KEY_REL
   74                     
   75                     ;;      RTS
   76                     
   77  03:E9D4  A5 C3             lda     <KEY_TRG
   78  03:E9D6  29 0F             and     #(KEY_UP|KEY_DOWN|KEY_LEFT|KEY_RIGHT)
   79  03:E9D8  F0 0C             beq     .main                   ; 新たに押されたキーがない?
   80                     
   81  03:E9DA  A8                tay
   82  03:E9DB  B9 1B EA          lda  ro_keytable, y             ; 同時押し対策 (下上右左の順に優先)
   83  03:E9DE  85 CA             sta     <REP_KEY                ; 新たに押されたキーをリピート用に設定
   84  03:E9E0  A9 18             lda     #REP_WAIT
   85  03:E9E2  85 CC             sta     <REP_CNT                ; 初回ウェイト
   86           0001              .if     1
   87           0018               .if     REP_WAIT
   88  03:E9E4  D0 16               bne   .press                  ; =bra  押し始めは押下あり
   89                              .else
   91                              .endif
   92                             .else
   95                             .endif
   96  03:E9E6            .main:
   97  03:E9E6  A5 C5             lda     <KEY_NEW
   98  03:E9E8  25 CA             and     <REP_KEY
   99  03:E9EA  F0 12             beq     .set                    ; リピート用キーが押されていない (a=0)?
  100                     
  101  03:E9EC  C6 CC             dec     <REP_CNT                ; ウェイトのカウントダウン
  102  03:E9EE  F0 0C             beq     .press                  ; 初回ウェイト終了か?
  103  03:E9F0  A5 CC             lda     <REP_CNT
  104  03:E9F2  49 F8             eor     #-REP_INTERVAL
  105  03:E9F4  C9 01             cmp     #1                      ; c = 0:一致 / 1:不一致
  106  03:E9F6  A9 00             lda     #0                      ; カウンタ初期値 または 押下キーなし
  107  03:E9F8  B0 04             bcs     .set                    ; 2 回目以降のウェイト終了でないか?
  108                     
  109  03:E9FA  85 CC             sta     <REP_CNT                ; カウンタを戻す。
  110  03:E9FC            .press:
  111  03:E9FC  A5 CA             lda     <REP_KEY
  112  03:E9FE            .set:
  113  03:E9FE  85 CB             sta     <REP_NEW                ; リピートにより ON/OFF される押下状態
  114  03:EA00  60                rts
