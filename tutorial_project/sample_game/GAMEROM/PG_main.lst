   73                     ; [SCR_ADR] から１バイト A reg に入れてアドレスをインクリメント
   74                     ;  IN: SRC_ADR 転送元アドレス 16bit
   75                     ;  OUT: A reg  取得したデータ
   76                     ;=======================
   77  03:ECC5            getSCR_ADR_DATA:
   78  03:ECC5  84 F0             sty  <TMP_SYS
   79  03:ECC7  A0 00             ldy  #0
   80  03:ECC9  B1 56             lda  [SRC_ADR],Y
   81  03:ECCB  08                php
   82  03:ECCC  A4 F0             ldy  <TMP_SYS
   83                             incw <SRC_ADR
       03:ECCE  E6 56             inc     <SRC_ADR
       03:ECD0  D0 02             bne     .iend00562
                          
       03:ECD2  E6 57             inc     <SRC_ADR + 1
       03:ECD4            .iend00562:
                          
   84  03:ECD4  28                plp
   85  03:ECD5  60                rts
   86                     
   87  03:ECD6            incSCR_ADR:
   88                             incw <SRC_ADR
       03:ECD6  E6 56             inc     <SRC_ADR
       03:ECD8  D0 02             bne     .iend00563
                          
       03:ECDA  E6 57             inc     <SRC_ADR + 1
       03:ECDC            .iend00563:
                          
   89  03:ECDC  60                rts
   90                     
   91  03:ECDD            decSCR_ADR:
   92                             decw <SRC_ADR
       03:ECDD  A5 56             lda     <SRC_ADR
       03:ECDF  D0 02             bne     .dend00564
                          
       03:ECE1  C6 57             dec     <SRC_ADR + 1
       03:ECE3            .dend00564:
       03:ECE3  C6 56             dec     <SRC_ADR
                          
   93  03:ECE5  60                rts
